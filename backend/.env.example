# ================================================================
# LexIntel AI - Environment Configuration Template
# ================================================================
# Copy this file to .env and fill in your actual values.
# cp .env.example .env
# ================================================================

# --- Database ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_db_user:your_db_password@your_db_host:5432/your_db_name

# --- JWT Authentication ---
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_signing_key_here
ALGORITHM=HS256
# Token expiry in minutes (10080 = 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- App Settings ---
APP_ENV=development
APP_PORT=8000
